# ========================================================
# Tamil Kids AI - Configuration & Environment Variables
# ========================================================

# General & Environment
APP_ENV=development
APP_NAME="Tamil Kids AI Automation"
SECRET_KEY=replace_with_a_secure_random_hex_string_64_chars_min
API_V1_STR=/api/v1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_123

# Server & CORS
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Default: SQLite for local zero-config, or Supabase PostgreSQL URL)
# Example Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./tamil_kids_ai.db

# AI Story & Topic Generation (Gemini Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Tamil TTS Voice Configuration
# Available edge-tts voices: ta-IN-PallaviNeural (Female, gentle storytelling), ta-IN-ValluvarNeural (Male)
TAMIL_TTS_VOICE=ta-IN-PallaviNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Video Production & Paths
BLENDER_PATH=blender
# Leave empty to automatically use Python bundled imageio-ffmpeg
FFMPEG_PATH=
TARGET_VIDEO_DURATION_MINUTES=10
# 360p keeps RAM low on free servers (512MB). Use 1920x1080 only on a strong PC.
VIDEO_FPS=15
VIDEO_WIDTH=640
VIDEO_HEIGHT=360

# Daily Automation Scheduler
DAILY_PUBLISH_TIME=09:00
TIMEZONE=Asia/Kolkata
AUTO_PUBLISH_ENABLED=false
REQUIRE_MANUAL_APPROVAL=true

# YouTube Data API v3 OAuth Settings
YOUTUBE_CLIENT_SECRETS_FILE=backend/client_secrets.json
YOUTUBE_OAUTH_TOKEN_FILE=backend/youtube_token.json
YOUTUBE_MADE_FOR_KIDS=true
YOUTUBE_PRIVACY_STATUS=private
